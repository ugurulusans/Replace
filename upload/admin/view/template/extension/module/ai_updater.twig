{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="pull-right">
        <button type="button" id="button-update-products" data-toggle="tooltip" title="{{ button_update_products }}" class="btn btn-primary"><i class="fa fa-play"></i> {{ button_update_products }}</button>
        <a href="{{ cancel }}" data-toggle="tooltip" title="{{ button_cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ul class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
        <li><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <div class="container-fluid">
    {% if error_warning %}
    <div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ error_warning }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    {% if success %}
    <div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ success }}
      <button type="button" class="close" data-dismiss="alert">&times;</button>
    </div>
    {% endif %}
    <div class="panel panel-default">
      <div class="panel-heading">
        <h3 class="panel-title"><i class="fa fa-pencil"></i> {{ text_edit }}</h3>
      </div>
      <div class="panel-body">
        <form action="{{ action_settings }}" method="post" enctype="multipart/form-data" id="form-module">
           <div class="form-group">
                <label class="col-sm-2 control-label" for="input-status">{{ entry_status }}</label>
                <div class="col-sm-10">
                    <select name="module_ai_updater_status" id="input-status" class="form-control">
                        {% if module_ai_updater_status %}
                        <option value="1" selected="selected">{{ text_enabled }}</option>
                        <option value="0">{{ text_disabled }}</option>
                        {% else %}
                        <option value="1">{{ text_enabled }}</option>
                        <option value="0" selected="selected">{{ text_disabled }}</option>
                        {% endif %}
                    </select>
                </div>
            </div>
            <div class="form-group required">
                <label class="col-sm-2 control-label" for="input-api-key">{{ entry_api_key }}</label>
                <div class="col-sm-10">
                    <input type="text" name="module_ai_updater_api_key" value="{{ module_ai_updater_api_key }}" placeholder="{{ entry_api_key }}" id="input-api-key" class="form-control" />
                    {% if error_api_key %}
                    <div class="text-danger">{{ error_api_key }}</div>
                    {% endif %}
                     <small class="form-text text-muted">{{ help_api_key }}</small>
                </div>
            </div>
             <div class="form-group">
                <div class="col-sm-10 col-sm-offset-2">
                    <button type="submit" form="form-module" data-toggle="tooltip" title="{{ button_save }}" class="btn btn-success"><i class="fa fa-save"></i> {{ button_save_settings }}</button>
                </div>
            </div>
        </form>
        <hr>
        <h4>{{ tab_product_update }}</h4>
        <div id="product-update-form">
            <div class="form-group">
                <label class="col-sm-2 control-label" for="input-fields-to-update">{{ entry_fields_to_update }}</label>
                <div class="col-sm-10">
                    <select name="fields_to_update[]" id="input-fields-to-update" class="form-control" multiple="multiple" size="5">
                        <option value="name">{{ text_field_name }}</option>
                        <option value="description">{{ text_field_description }}</option>
                        <option value="meta_title">{{ text_field_meta_title }}</option>
                        <option value="meta_description">{{ text_field_meta_description }}</option>
                        <option value="meta_keyword">{{ text_field_meta_keyword }}</option>
                        {# SEO URL eklenecekse: <option value="seo_url">{{ text_field_seo_url }}</option> #}
                    </select>
                    <small class="form-text text-muted">{{ help_fields_to_update }}</small>
                </div>
            </div>
            <div class="form-group">
                <label class="col-sm-2 control-label" for="input-manual-description">{{ entry_manual_description }}</label>
                <div class="col-sm-10">
                    <textarea name="manual_description" rows="5" placeholder="{{ entry_manual_description }}" id="input-manual-description" class="form-control"></textarea>
                    <small class="form-text text-muted">{{ help_manual_description }}</small>
                </div>
            </div>
            <div class="form-group">
                 <label class="col-sm-2 control-label">{{ entry_products }}</label>
                 <div class="col-sm-10">
                    <input type="text" name="filter_name" value="" placeholder="{{ entry_filter_name }}" id="input-filter-name" class="form-control" />
                    <div id="product-list" class="well well-sm" style="height: 250px; overflow: auto;">
                        {# Ürünler AJAX ile buraya yüklenecek #}
                        {{ text_no_products_found }}
                    </div>
                 </div>
            </div>
            <div class="form-group">
                <div class="col-sm-10 col-sm-offset-2">
                     <div id="update-progress" style="display:none;">
                        <div class="progress">
                            <div class="progress-bar progress-bar-striped active" role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100" style="width:0%">
                                <span class="sr-only">0% Complete</span>
                            </div>
                        </div>
                        <p id="progress-text">Processing...</p>
                        <div id="live-log-output" style="max-height: 150px; overflow-y: auto; border: 1px solid #ddd; padding: 5px; margin-top: 10px; font-size: 12px; line-height: 1.4em; background-color: #f9f9f9; display: none;">
                            <!-- Live logs will appear here -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$(document).ready(function() {
    // API Key kaydetme butonu için form ID
    $('#form-module button[type=\'submit\']').on('click', function() {
        $('#form-module').attr('action', '{{ action_settings }}'); // Ensure correct action for settings save
    });

    // Ürünleri filtreleme ve listeleme
    function filterProducts() {
        var filter_name = $('input[name=\'filter_name\']').val();
        $.ajax({
            url: 'index.php?route=extension/module/ai_updater/loadProducts&user_token={{ user_token }}',
            type: 'get',
            data: 'filter_name=' + encodeURIComponent(filter_name),
            dataType: 'json',
            success: function(json) {
                var html = '';
                if (json['products'] && json['products'].length) {
                    $.each(json['products'], function(i, product) {
                        html += '<div class="checkbox">';
                        html += '  <label><input type="checkbox" name="selected_products[]" value="' + product.product_id + '"> ' + product.name + '</label>';
                        html += '</div>';
                    });
                } else {
                    html = '{{ text_no_products_found }}';
                }
                $('#product-list').html(html);
            },
            error: function(xhr, ajaxOptions, thrownError) {
                alert(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
            }
        });
    }

    $('input[name=\'filter_name\']').on('keyup', function() {
        filterProducts();
    });
    filterProducts(); // Sayfa yüklendiğinde ürünleri listele

    // Ürünleri Güncelle Butonu
    $('#button-update-products').on('click', function() {
        var selected_products = [];
        $('input[name^=\'selected_products\']:checked').each(function() {
            selected_products.push($(this).val());
        });

        var fields_to_update = $('#input-fields-to-update').val();
        var manual_description = $('textarea[name=\'manual_description\']').val();

        if (selected_products.length == 0) {
            alert('{{ error_no_product_selected }}');
            return false;
        }
        if (fields_to_update == null || fields_to_update.length == 0) {
            alert('{{ error_no_fields_selected }}');
            return false;
        }

        // Progress bar'ı göster
        $('#update-progress').show();
        var total_products = selected_products.length;
        var processed_products = 0;
        var $progressBar = $('#update-progress .progress-bar');
        var $progressText = $('#progress-text');
        var $liveLogOutput = $('#live-log-output');

        $progressBar.removeClass('progress-bar-danger progress-bar-warning').css('width', '0%').attr('aria-valuenow', 0).text('0%');
        $progressText.text('{{ text_processing_product }} 0 / ' + total_products);
        $liveLogOutput.html('').show(); // Clear previous logs and show the area


        var overall_success_messages = [];
        var overall_error_messages = [];
        var overall_warning_messages = [];
        var products_to_process = selected_products.slice(); // Orijinal diziyi korumak için kopyala

        $('#button-update-products').button('loading');
        $('.alert-dismissible').remove(); // Eski mesajları temizle

        function processNextProduct() {
            if (products_to_process.length === 0) {
                // Tüm ürünler işlendi
                $progressBar.css('width', '100%').attr('aria-valuenow', 100).text('100% {{ text_complete }}');
                $progressText.text('{{ text_update_complete }} (' + processed_products + '/' + total_products + ')');
                $('#button-update-products').button('reset');

                // Genel sonuç mesajlarını göster
                if (overall_error_messages.length > 0) {
                     $('#content > .container-fluid').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ text_completed_with_errors_summary }}<br>' + overall_error_messages.join('<br>') + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                }
                if (overall_warning_messages.length > 0) {
                     $('#content > .container-fluid').prepend('<div class="alert alert-warning alert-dismissible"><i class="fa fa-exclamation-circle"></i> {{ text_completed_with_warnings_summary }}<br>' + overall_warning_messages.join('<br>') + ' <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                }
                if (overall_success_messages.length > 0 && overall_error_messages.length === 0 && overall_warning_messages.length === 0) { // Sadece başarı varsa
                    $('#content > .container-fluid').prepend('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> {{ text_all_products_updated_successfully }} ('+ total_products + '/' + total_products +') <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                } else if (overall_success_messages.length > 0) { // Kısmi başarı
                     $('#content > .container-fluid').prepend('<div class="alert alert-success alert-dismissible"><i class="fa fa-check-circle"></i> ' + overall_success_messages.length + ' {{ text_products_updated_successfully_summary }} <button type="button" class="close" data-dismiss="alert">&times;</button></div>');
                }


                filterProducts(); // Ürün listesini yenile
                $('html, body').animate({ scrollTop: 0 }, 'slow');
                // Don't hide progress immediately, let user see the final log output for a bit
                // setTimeout(function() {
                //     // $('#update-progress').hide(); // Keep it visible
                //     // $progressBar.removeClass('progress-bar-danger progress-bar-warning').css('width', '0%').attr('aria-valuenow', 0).text('0%');
                // }, 7000);
                return;
            }

            var current_product_id = products_to_process.shift();
            // var current_product_index = total_products - products_to_process.length - 1; // Not used currently

            var log_message_start = 'Product ID ' + current_product_id + ': ';
            $liveLogOutput.append('<p style="margin-bottom: 2px;">' + log_message_start + '{{ text_sending_data_to_ai_short }}</p>');
            $liveLogOutput.scrollTop($liveLogOutput[0].scrollHeight);


            $progressText.text('{{ text_processing_product }} ' + (processed_products + 1) + ' / ' + total_products + ' (ID: ' + current_product_id + ')');

            $.ajax({
                url: '{{ action_update_products }}', // Bu URL'in tek bir ürünü işleyebilmesi gerekecek
                type: 'post',
                dataType: 'json',
                data: {
                    selected_products: [current_product_id], // Tek bir ürün ID'si gönderiyoruz
                    fields_to_update: fields_to_update,
                    manual_description: manual_description,
                    user_token: '{{ user_token }}' // user_token'ı da gönderelim
                },
                success: function(json) {
                    var log_entry = '';
                    if (json['error']) {
                        log_entry = '<span style="color: red;">Error: ' + json['error'] + '</span>';
                        overall_error_messages.push(log_message_start + json['error']);
                        $progressBar.addClass('progress-bar-danger');
                    } else if (json['warning']) {
                        log_entry = '<span style="color: orange;">Warning: ' + json['warning'] + '</span>';
                        overall_warning_messages.push(log_message_start + json['warning']);
                        // $progressBar.addClass('progress-bar-warning'); // Can make the bar look messy if many warnings
                    } else if (json['success']) {
                        log_entry = '<span style="color: green;">' + json['success'] + '</span>';
                        overall_success_messages.push(json['success']);
                    } else {
                        log_entry = '<span style="color: orange;">Notice: No specific status returned.</span>';
                         overall_warning_messages.push(log_message_start + 'No specific status returned.');
                    }
                    // Update the last log entry for this product, or append a new one
                    $liveLogOutput.find('p:contains("' + log_message_start + '{{ text_sending_data_to_ai_short }}")').remove();
                    $liveLogOutput.append('<p style="margin-bottom: 2px;">' + log_message_start + log_entry + '</p>');
                    $liveLogOutput.scrollTop($liveLogOutput[0].scrollHeight);
                },
                error: function(xhr, ajaxOptions, thrownError) {
                    var error_msg = 'Request Failed - ' + thrownError + " " + xhr.statusText;
                    $liveLogOutput.find('p:contains("' + log_message_start + '{{ text_sending_data_to_ai_short }}")').remove();
                    $liveLogOutput.append('<p style="margin-bottom: 2px;"><span style="color: red;">' + log_message_start + error_msg + '</span></p>');
                    $liveLogOutput.scrollTop($liveLogOutput[0].scrollHeight);
                    overall_error_messages.push(log_message_start + error_msg);
                    $progressBar.addClass('progress-bar-danger');
                },
                complete: function() {
                    processed_products++;
                    var percentage = Math.round((processed_products / total_products) * 100);
                    $progressBar.css('width', percentage + '%').attr('aria-valuenow', percentage).text(percentage + '%');
                    processNextProduct(); // Bir sonraki ürünü işle
                }
            });
        }

        processNextProduct(); // İlk ürünü işlemeye başla
    });

    // Multi-select için (eğer Bootstrap Select veya Select2 gibi bir kütüphane kullanılıyorsa)
    // $('#input-fields-to-update').selectpicker(); // Örnek
});
//--></script>
{{ footer }}
